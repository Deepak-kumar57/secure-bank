# SecureBank backend environment
# Copy to .env and fill in.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=securebank

# --- Auth ---
# Replace with a long random string in real deployments.
JWT_SECRET=change_this_to_a_long_random_string_for_jwt_signing
JWT_EXPIRES_IN=12h

# --- CORS ---
CLIENT_ORIGIN=http://localhost:5173
